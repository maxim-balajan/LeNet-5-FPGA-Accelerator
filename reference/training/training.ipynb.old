   ],
   "source": [
    "import tensorflow as tf\n",
    "from tensorflow import keras\n",
    "import numpy as np\n",
    "\n",
    "def convert_data(x_data: np.ndarray, y_data: np.ndarray):\n",
    "    # hacky way to increase the size of a (unknown)x28x28 to (unknown)x32x32\n",
    "    # by appending two zeros at all sides of the 28x28 matrix\n",
    "    tmp = np.zeros((x_data.shape[0], 2, x_data.shape[2]))\n",
    "    x_data = np.append(x_data, tmp, axis=1)\n",
    "    x_data = np.append(tmp, x_data, axis=1)\n",
    "    tmp = np.zeros((x_data.shape[0], x_data.shape[1], 2))\n",
    "    x_data = np.append(x_data, tmp, axis=2)\n",
    "    x_data = np.append(tmp, x_data, axis=2)\n",
    "\n",
    "    # change dimensions: (unknown)x32x32 to (unknown)x32x32x1\n",
    "    x_data = np.expand_dims(x_data, -1)\n",
    "    # change dimensions: (unknown) to (unknown)x10\n",
    "    y_data = keras.utils.to_categorical(y_data, 10)\n",
    "\n",
    "    # return (x_data - 128, y_data)\n",
    "    return (x_data / 256.0, y_data)\n",
    "\n",
    "\n",
    "# for now we are just interested in the training data and not the test data\n",
    "(X_train, y_train), (X_test, y_test) = tf.keras.datasets.mnist.load_data()\n",
    "\n",
    "(X_train, y_train) = convert_data(X_train, y_train)\n",
    "(X_test, y_test) = convert_data(X_test, y_test)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "# save data\n",
    "np.save(\"export/mnist/x_train.npy\", X_train)\n",
    "np.save(\"export/mnist/y_train.npy\", y_train)\n",
    "np.save(\"export/mnist/x_test.npy\", X_test)\n",
    "np.save(\"export/mnist/y_test.npy\", y_test)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Shapes:\n",
      "((60000, 32, 32, 1), (60000, 10))\n"
     ]
    }
   ],
   "source": [
    "print(\"Shapes:\")\n",
    "print((X_train.shape, y_train.shape))"
   ]
  },
